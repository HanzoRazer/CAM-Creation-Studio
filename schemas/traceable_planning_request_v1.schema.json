{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "creation-studio.traceable-planning-request/1",
  "title": "TraceablePlanningRequestV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "request_id",
    "workflow_origin",
    "package_id",
    "subject",
    "geometry",
    "units",
    "coordinate_frame",
    "stock",
    "operation",
    "tooling",
    "strategy",
    "machine_profile",
    "removal_region",
    "positional_tolerance_mm",
    "upstream_artifacts"
  ],
  "properties": {
    "contract_version": {
      "const": "creation-studio.traceable-planning-request/1"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "workflow_origin": {
      "const": "imported",
      "description": "This contract is only for imported artifact chains. Ordinary human-authored jobs use the existing manual job contract; relabeling a chain is refused."
    },
    "package_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        }
      }
    },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        }
      }
    },
    "units": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "coordinate_frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        }
      }
    },
    "stock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "material_id",
        "x_mm",
        "y_mm",
        "z_mm"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        },
        "material_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        },
        "x_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "y_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "z_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "centerline"
      ],
      "properties": {
        "type": {
          "const": "closed_rectangular_contour"
        },
        "centerline": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x_min_mm",
            "y_min_mm",
            "x_max_mm",
            "y_max_mm"
          ],
          "properties": {
            "x_min_mm": {
              "type": "number"
            },
            "y_min_mm": {
              "type": "number"
            },
            "x_max_mm": {
              "type": "number"
            },
            "y_max_mm": {
              "type": "number"
            }
          }
        }
      }
    },
    "tooling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "orientation",
        "diameter_mm"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        },
        "orientation": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        },
        "diameter_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "depth_levels_mm",
        "travel_height_mm",
        "clearance_mm",
        "stepdown_mm",
        "stock_allowance_mm"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        },
        "depth_levels_mm": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "$comment": "The parser additionally requires strictly increasing levels."
        },
        "travel_height_mm": {
          "type": "number"
        },
        "clearance_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "stepdown_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "stock_allowance_mm": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "machine_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        }
      }
    },
    "removal_region": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x_min_mm",
        "y_min_mm",
        "x_max_mm",
        "y_max_mm",
        "max_depth_mm"
      ],
      "properties": {
        "x_min_mm": {
          "type": "number"
        },
        "y_min_mm": {
          "type": "number"
        },
        "x_max_mm": {
          "type": "number"
        },
        "y_max_mm": {
          "type": "number"
        },
        "max_depth_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "positional_tolerance_mm": {
      "type": "number",
      "minimum": 0
    },
    "upstream_artifacts": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/artifact"
      },
      "allOf": [
        {
          "contains": {
            "properties": {
              "role": {
                "const": "proposal"
              }
            },
            "required": [
              "role"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "role": {
                "const": "validation"
              }
            },
            "required": [
              "role"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "role": {
                "const": "admission"
              }
            },
            "required": [
              "role"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "role": {
                "const": "geometry"
              }
            },
            "required": [
              "role"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "role": {
                "const": "subject"
              }
            },
            "required": [
              "role"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "contract_id",
        "contract_version",
        "artifact_id",
        "package_ref",
        "sha256"
      ],
      "properties": {
        "role": {
          "enum": [
            "proposal",
            "validation",
            "admission",
            "geometry",
            "subject"
          ]
        },
        "contract_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        },
        "contract_version": {
          "const": "fixture-1"
        },
        "artifact_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        },
        "package_ref": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "role": {
                "const": "proposal"
              }
            }
          },
          "then": {
            "properties": {
              "contract_id": {
                "const": "experimental.cam-assist.proposal"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "validation"
              }
            }
          },
          "then": {
            "properties": {
              "contract_id": {
                "const": "experimental.cam-assist.validation"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "admission"
              }
            }
          },
          "then": {
            "properties": {
              "contract_id": {
                "const": "experimental.cam-assist.admission"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "geometry"
              }
            }
          },
          "then": {
            "properties": {
              "contract_id": {
                "const": "experimental.creation-studio.geometry"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "subject"
              }
            }
          },
          "then": {
            "properties": {
              "contract_id": {
                "const": "experimental.creation-studio.subject"
              }
            }
          }
        }
      ]
    }
  }
}
